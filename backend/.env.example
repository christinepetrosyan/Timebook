# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=timebook
DB_PASSWORD=timebook
DB_NAME=timebook
DB_SSLMODE=disable

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# JWT Configuration (REQUIRED in production - change this value!)
JWT_SECRET=your-secret-key-here-change-in-production

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment (development, production)
ENVIRONMENT=development

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Email (SMTP) - for appointment notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@timebook.app

# Alternative: SendGrid (set SENDGRID_API_KEY instead of SMTP_*)
# SENDGRID_API_KEY=

# Base URL for links in emails (e.g. http://localhost:5173)
APP_BASE_URL=http://localhost:5173

# Telegram - create bot via @BotFather
TELEGRAM_BOT_TOKEN=Timebook
TELEGRAM_BOT_USERNAME=TimeBookNotifs_bot

# WhatsApp - Meta Business API (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Viber - Viber Business (optional)
VIBER_AUTH_TOKEN=
